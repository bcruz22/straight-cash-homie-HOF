ost_basis":"Drafted in round 15 in 2026","pts":67.3},{"key":"Timmy|7042","manager":"Timmy","player":"Tyler Bass","pos":"K","nfl_team":"BUF","eligible":true,"years_kept_in_a_row":0,"status":"Eligible","cost_round":12,"cost_basis":"Free agent or waiver pickup","pts":64.0},{"key":"Timmy|11624","manager":"Timmy","player":"Xavier Worthy","pos":"WR","nfl_team":"KC","eligible":true,"years_kept_in_a_row":0,"status":"Eligible","cost_round":14,"cost_basis":"Drafted in round 14 in 2026","pts":61.1},{"key":"Timmy|5045","manager":"Timmy","player":"Courtland Sutton","pos":"WR","nfl_team":"DEN","eligible":true,"years_kept_in_a_row":0,"status":"Eligible","cost_round":7,"cost_basis":"Drafted in round 7 in 2026","pts":51.1},{"key":"Timmy|4984","manager":"Timmy","player":"Josh Allen","pos":"QB","nfl_team":"BUF","eligible":false,"years_kept_in_a_row":2,"status":"Not eligible: kept in 2025 and 2026","cost_round":1,"cost_basis":"Kept at round 1 in 2026","pts":308.95}],"meta":[{"label":"keepers_next.py","value":"# Keeper options for next season's draft, from current Sleeper rosters and league keeper rules:\n# - max 2 straight seasons as a keeper (any roster); cost = round the player went in this season's draft\n#   (drafted or kept), else round 12 for a free agent / waiver pickup.\nimport json, glob, os, sys, datetime\nRAW, OUT, SCRIPTS = sys.argv[1], sys.argv[2], sys.argv[3]\nST = json.load(open(f\"{RAW}/state.json\"))   # written by pull.py\nCUR = int(ST[\"season\"]); NEXT = CUR + 1\nLAST_WEEK = 99 if ST[\"complete\"] else ST[\"last_completed_week\"]\nP = json.load(open(f\"{RAW}/players.json\"))\nS = {int(json.load(open(f))[\"league\"][\"season\"]): json.load(open(f)) for f in sorted(glob.glob(f\"{RAW}/20*.json\"))}\ndef name(pid):\n    p = P.get(pid) or {}\n    return f\"{pid} D/ST\" if p.get(\"position\") == \"DEF\" else f\"{p.get('first_name','')} {p.get('last_name','')}\".strip() or pid\nTRACKER = json.load(open(f\"{RAW}/tracker.json\"))  # commissioner corrections to Sleeper keeper flags\nkept_years = {}  # Sleeper keeper flags (2021 on); only the last two seasons matter for eligibility\nfor y, s in S.items():\n    for d in s[\"drafts\"]:\n        for p in d[\"picks\"]:\n            nm = name(p[\"player_id\"]).lower()\n            if p.get(\"is_keeper\") and not any(x[\"season\"] == str(y) and nm.endswith(x[\"last\"].lower()) for x in TRACKER[\"not_keepers\"]):\n                kept_years.setdefault(p[\"player_id\"], set()).add(y)\ncur = S[CUR]\ndraft_round, draft_kept = {}, {}\nfor d in cur[\"drafts\"]:\n    for p in d[\"picks\"]:\n        draft_round[p[\"player_id\"]] = p[\"round\"]; draft_kept[p[\"player_id\"]] = bool(p.get(\"is_keeper\"))\npts = {}\nfor w, wk in cur[\"matchups\"].items():\n    if int(w) > LAST_WEEK: continue\n    for m in wk:\n        for pid, v in (m.get(\"players_points\") or {}).items(): pts[pid] = pts.get(pid, 0) + (v or 0)\nDISPLAY = json.load(open(f\"{RAW}/tracker.json\"))[\"display\"]  # real names from the commissioner's tracker\nusers = {u[\"user_id\"]: DISPLAY.get(u[\"user_id\"], u[\"display_name\"]) for u in cur[\"users\"]}\nrows = []\nfor r in cur[\"rosters\"]:\n    mgr = users.get(r[\"owner_id\"], f\"Team {r['roster_id']}\")\n    for pid in r.get(\"players\") or []:\n        streak, y = 0, CUR\n        while y in kept_years.get(pid, set()): streak += 1; y -= 1\n        eligible = streak < 2\n        if pid in draft_round:\n            rd = draft_round[pid]\n            basis = f\"Kept at round {rd} in {CUR}\" if draft_kept[pid] else f\"Drafted in round {rd} in {CUR}\"\n        else:\n            rd, basis = 12, \"Free agent or waiver pickup\"\n        status = (\"Not eligible: kept in \" + \" and \".join(str(CUR - i) for i in range(streak - 1, -1, -1))) if not eligible else \\\n                 (\"Eligible: would be 2nd straight year kept\" if streak == 1 else \"Eligible\")\n        pos = (P.get(pid) or {}).get(\"position\") or \"\"\n        rows.append({\"key\": f\"{mgr}|{pid}\", \"manager\": mgr, \"player\": name(pid), \"pos\": pos, \"nfl_team\": (P.get(pid) or {}).get(\"team\") or \"\",\n                     \"eligible\": eligible, \"years_kept_in_a_row\": streak, \"status\": status, \"cost_round\": rd, \"cost_basis\": basis,\n                     \"pts\": round(pts.get(pid, 0), 2)})\nrows.sort(key=lambda r: (r[\"manager\"].lower(), not r[\"eligible\"], -r[\"pts\"]))\ncode = [{\"label\": \"keepers_next.py\", \"value\": open(os.path.join(SCRIPTS, \"keepers_next.py\")).read(), \"type\": \"code\", \"lang\": \"python\"},\n        {\"label\": \"pull.py\", \"value\": open(os.path.join(SCRIPTS, \"pull.py\")).read(), \"type\": \"code\", \"lang\": \"python\"}]\nmeta = code + [{\"label\": \"Input\", \"value\": \"Sleeper API (api.sleeper.app), league 1389303477989048320: current rosters, every season's draft keeper flags, 2026 weekly player points\"},\n               {\"label\": \"Pulled\", \"value\": f\"{datetime.date.today().isoformat()}, rosters as of that day\" + (f\", points through week {LAST_WEEK}\" if LAST_WEEK < 99 else \"\")}]\njson.dump({\"rows\": rows, \"meta\": meta}, open(f\"{OUT}/keeper_options.json\", \"w\"), ensure_ascii=False, separators=(\",\", \":\"))\nprint(len(rows), sum(r[\"eligible\"] for r in rows), \"eligible\")\nfor r in rows:\n    if not r[\"eligible\"] or r[\"years_kept_in_a_row\"]: print(r[\"manager\"], r[\"player\"], r[\"status\"], r[\"cost_round\"])\n","type":"code","lang":"python"},{"label":"pull.py","value":"import json, sys, os, urllib.request, time\nB=\"https://api.sleeper.app/v1\"\nout=sys.argv[2]\ndef get(p):\n    for i in range(4):\n        try:\n            with urllib.request.urlopen(B+p, timeout=30) as r: return json.load(r)\n        except Exception as e:\n            time.sleep(2**i); err=e\n    raise err\nlid=sys.argv[1]; seasons=[]\nUSER = sys.argv[3] if len(sys.argv) > 3 else None   # commissioner's Sleeper user id, to find next season's league\nstate = get(\"/state/nfl\")\nif USER:  # a new season's league points back to the one we know; follow the chain forward\n    for yr in (int(state[\"league_season\"]), int(state[\"league_season\"]) + 1):\n        for lg in get(f\"/user/{USER}/leagues/nfl/{yr}\") or []:\n            chain, cur = set(), lg[\"league_id\"]\n            for _ in range(15):\n                if not cur or cur == \"0\" or cur in chain: break\n                chain.add(cur)\n                if cur == lid: break\n                cur = (get(f\"/league/{cur}\") or {}).get(\"previous_league_id\")\n            if lid in chain: lid = lg[\"league_id\"]\nnewest = None\nwhile lid and lid!=\"0\":\n    L=get(f\"/league/{lid}\"); s={\"league\":L}\n    s[\"users\"]=get(f\"/league/{lid}/users\"); s[\"rosters\"]=get(f\"/league/{lid}/rosters\")\n    s[\"winners\"]=get(f\"/league/{lid}/winners_bracket\"); s[\"losers\"]=get(f\"/league/{lid}/losers_bracket\")\n    last=(L[\"settings\"].get(\"playoff_week_start\") or 15)+3\n    s[\"matchups\"]={};s[\"tx\"]={}\n    for w in range(1,min(last,19)):\n        m=get(f\"/league/{lid}/matchups/{w}\")\n        if m: s[\"matchups\"][w]=m\n        s[\"tx\"][w]=get(f\"/league/{lid}/transactions/{w}\")\n    s[\"drafts\"]=[]\n    for d in get(f\"/league/{lid}/drafts\"):\n        s[\"drafts\"].append({\"draft\":d,\"picks\":get(f\"/draft/{d['draft_id']}/picks\"),\"traded\":get(f\"/draft/{d['draft_id']}/traded_picks\")})\n    json.dump(s,open(f\"{out}/{L['season']}.json\",\"w\"))\n    if newest is None:  # last completed week of the newest season\n        newest = L[\"season\"]\n        import datetime, zoneinfo\n        if L[\"status\"] == \"complete\" or state[\"season\"] != L[\"season\"] or state[\"season_type\"] == \"off\":\n            done = max((int(w) for w in s[\"matchups\"]), default=0)\n        else:\n            done = int(state[\"week\"]) - 1\n            now = datetime.datetime.now(zoneinfo.ZoneInfo(\"America/New_York\"))\n            wk = s[\"matchups\"].get(int(state[\"week\"])) or []\n            if now.weekday() in (1, 2) and wk and all((m.get(\"points\") or 0) > 0 for m in wk): done = int(state[\"week\"])\n        json.dump({\"league_id\": L[\"league_id\"], \"season\": L[\"season\"], \"complete\": L[\"status\"] == \"complete\", \"last_completed_week\": done,\n                   \"pulled_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec=\"minutes\")}, open(f\"{out}/state.json\", \"w\"))\n    print(L[\"season\"],L[\"name\"],L[\"status\"],L[\"total_rosters\"],\"teams\", len(s[\"matchups\"]),\"wks\")\n    lid=L.get(\"previous_league_id\")\n","type":"code","lang":"python"},{"label":"Input","value":"Sleeper API (api.sleeper.app), league 1389303477989048320: current rosters, every season's draft keeper flags, 2026 weekly player points"},{"label":"Pulled","value":"2026-11-25, rosters as of that day, points through week 11"}]}